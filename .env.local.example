# Copy this file to .env.local and fill in your own values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only students with an email ending in this domain can sign up.
# Leave blank to allow any email (not recommended for a real launch).
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAIN=yourcollege.ac.in
